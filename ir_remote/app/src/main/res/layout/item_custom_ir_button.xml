<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_timer_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Icon Squircle -->
        <LinearLayout
            android:id="@+id/layout_item_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_samsung_chip_unselected"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_item_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Title & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/layout_item_icon"
            android:layout_toStartOf="@+id/item_actions_row"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Projector Power"
                android:textColor="#0F172A"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_item_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Ready to transmit"
                    android:textColor="#166534"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_item_timer_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="⏰ 10:30 PM"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Actions: BLAST, Edit, Delete -->
        <LinearLayout
            android:id="@+id/item_actions_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Instant Blast Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_item_blast"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="⚡ SEND"
                android:textColor="#166534"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn_green"
                android:stateListAnimator="@null" />

            <!-- Edit Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_item_edit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:text="✏"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:background="@drawable/bg_sheet_btn"
                android:stateListAnimator="@null" />

            <!-- Delete Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_item_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:text="🗑"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:background="@drawable/bg_sheet_btn"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
