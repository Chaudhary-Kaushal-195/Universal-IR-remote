<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_action_chip"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/text_slot_number"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="#F1F5F9"
        android:text="1"
        android:textColor="#334155"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_slot_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AC 1"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_slot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Current: Bedroom AC • 8 Codes"
            android:textColor="#64748B"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_slot_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select"
        android:textColor="#0284C7"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_sheet_btn_blue"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp" />

</LinearLayout>
