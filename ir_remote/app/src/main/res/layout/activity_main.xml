<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0E0E0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================ -->
            <!-- 1. APP BAR: Menu Icon & Account Icon         -->
            <!-- ============================================ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="36dp"
                android:paddingTop="25dp"
                android:paddingBottom="16dp">

                <!-- Menu Icon -->
                <ImageView
                    android:id="@+id/btn_menu"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu"
                    android:tint="#424242"
                    android:contentDescription="Menu"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Hardware Status Indicator Pill -->
                <LinearLayout
                    android:id="@+id/hardware_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_hardware_pill_offline"
                    android:paddingHorizontal="14dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/hardware_status_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/hardware_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hardware Offline"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#475569"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- Person / Account Icon -->
                <ImageView
                    android:id="@+id/btn_person"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_person"
                    android:tint="#424242"
                    android:contentDescription="Account"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- ============================================ -->
            <!-- 2. WELCOME HOME BANNER                       -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="36dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/text_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Home,"
                    android:textSize="20sp"
                    android:textColor="#424242"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/text_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kaushal"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.02"
                    android:lineSpacingMultiplier="0.9" />
            </LinearLayout>

            <!-- ============================================ -->
            <!-- 3. DIVIDER                                   -->
            <!-- ============================================ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="36dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="25dp" />

            <!-- ============================================ -->
            <!-- 4. SMART DEVICES HEADER                      -->
            <!-- ============================================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Devices"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:fontFamily="sans-serif"
                android:layout_marginHorizontal="36dp"
                android:layout_marginBottom="16dp" />

            <!-- ============================================ -->
            <!-- 5. 2x2 SMART DEVICES GRID                    -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingBottom="30dp">

                <!-- ROW 1: Smart Light & Smart AC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <!-- 1. SMART LIGHT -->
                    <RelativeLayout
                        android:id="@+id/card_light"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_device_card_on"
                        android:paddingTop="25dp"
                        android:paddingBottom="20dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/icon_light"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/ic_device_light"
                            android:tint="#FFFFFF"
                            android:contentDescription="Smart Light" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/text_light"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Smart\nLight"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:lineSpacingExtra="2dp"
                                android:paddingStart="4dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_light"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:rotation="270"
                                android:checked="true" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- 2. SMART AC -->
                    <RelativeLayout
                        android:id="@+id/card_ac"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_device_card_off"
                        android:paddingTop="25dp"
                        android:paddingBottom="20dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/icon_ac"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/ic_device_ac"
                            android:tint="#616161"
                            android:contentDescription="Smart AC" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/text_ac"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Smart\nAC"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:fontFamily="sans-serif-medium"
                                android:lineSpacingExtra="2dp"
                                android:paddingStart="4dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_ac"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:rotation="270"
                                android:checked="false" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>

                <!-- ROW 2: Smart TV & Smart Fan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 3. SMART TV -->
                    <RelativeLayout
                        android:id="@+id/card_tv"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_device_card_off"
                        android:paddingTop="25dp"
                        android:paddingBottom="20dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/icon_tv"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/ic_device_tv"
                            android:tint="#616161"
                            android:contentDescription="Smart TV" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/text_tv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Smart\nTV"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:fontFamily="sans-serif-medium"
                                android:lineSpacingExtra="2dp"
                                android:paddingStart="4dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:rotation="270"
                                android:checked="false" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- 4. SMART FAN -->
                    <RelativeLayout
                        android:id="@+id/card_fan"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_device_card_off"
                        android:paddingTop="25dp"
                        android:paddingBottom="20dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/icon_fan"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/ic_device_fan"
                            android:tint="#616161"
                            android:contentDescription="Smart Fan" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/text_fan"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Smart\nFan"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:fontFamily="sans-serif-medium"
                                android:lineSpacingExtra="2dp"
                                android:paddingStart="4dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_fan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:rotation="270"
                                android:checked="false" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ============================================ -->
    <!-- FLOATING IN-APP POPUP NOTIFICATION BANNER    -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/toast_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_toast_banner"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:elevation="40dp"
        android:translationZ="40dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/toast_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/toast_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transmitting Signal..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

</FrameLayout>
