<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_samsung_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btn_close_export"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export IR Backup"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose whole database or a specific device"
                android:textColor="#64748B"
                android:textSize="12.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_close_export"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_sheet_btn"
            android:text="✕"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- 1. FULL DATABASE EXPORT (PRIMARY) -->
            <LinearLayout
                android:id="@+id/card_export_full"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_action_chip"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#E0F2FE"
                    android:text="🌐"
                    android:textSize="22sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Hub Database"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_sheet_btn_blue"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="All Devices"
                            android:textColor="#0284C7"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Exports all ACs, TVs, Lights, Fans &amp; Custom Buttons"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btn_export_full_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy"
                        android:textColor="#2563EB"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_sheet_btn"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/btn_export_full_file"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export"
                        android:textColor="#0284C7"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_sheet_btn_blue"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION LABEL: PARTICULAR DEVICES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PARTICULAR DEVICES &amp; REMOTES"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="10dp" />

            <!-- 2. CUSTOM IR BUTTONS -->
            <LinearLayout
                android:id="@+id/card_export_custom_ir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_action_chip"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="#FEF3C7"
                    android:text="✨"
                    android:textSize="18sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom IR Buttons"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_export_custom_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="All custom learned remotes and codes"
                        android:textColor="#64748B"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btn_export_custom_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy"
                        android:textColor="#2563EB"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_sheet_btn"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/btn_export_custom_file"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export"
                        android:textColor="#D97706"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_sheet_btn_blue"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. AIR CONDITIONERS CONTAINER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❄️ Air Conditioners (AC Profiles)"
                android:textColor="#475569"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_export_ac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- 4. TELEVISIONS CONTAINER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Televisions (TV Profiles)"
                android:textColor="#475569"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_export_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- 5. LIGHTS CONTAINER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Smart Lights"
                android:textColor="#475569"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_export_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- 6. FANS CONTAINER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌀 Smart Fans"
                android:textColor="#475569"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_export_fan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
