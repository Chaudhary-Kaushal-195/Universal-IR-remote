<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_action_chip"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/text_row_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="❄️"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AC 1 (Living Room)"
            android:textColor="#0F172A"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_row_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14 Learned Codes"
            android:textColor="#64748B"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_row_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_sheet_btn"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4.5dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btn_row_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export"
            android:textColor="#0284C7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_sheet_btn_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4.5dp" />
    </LinearLayout>

</LinearLayout>
