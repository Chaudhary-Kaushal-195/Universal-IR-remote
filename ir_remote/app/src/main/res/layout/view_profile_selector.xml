<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_profile_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:id="@+id/container_profile_chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/chip_profile_0"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_profile_chip_active"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Profile 1"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chip_profile_1"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_profile_chip_inactive"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Profile 2"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chip_profile_2"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_profile_chip_inactive"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Profile 3"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chip_profile_3"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_profile_chip_inactive"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Profile 4"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chip_profile_4"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_profile_chip_inactive"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Profile 5" />

    </LinearLayout>
</HorizontalScrollView>
