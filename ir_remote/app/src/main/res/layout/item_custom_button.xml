<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_timer_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Row 1: Title, ID & Status Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/tv_btn_status_badge">

            <TextView
                android:id="@+id/tv_custom_btn_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode: Cool"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_custom_btn_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="AC_MODE_COOL"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_btn_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_action_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="⚪ Not Learned"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Row 2: Action Buttons: Test, Learn, Clear/Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action_test"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⚡ Test"
            android:textColor="#166534"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_sheet_btn_green"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action_learn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="🎯 Learn"
            android:textColor="#1E293B"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_sheet_btn"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="🗑"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:background="@drawable/bg_sheet_btn"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
