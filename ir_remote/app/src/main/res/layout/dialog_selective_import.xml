<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_samsung_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btn_close_selective"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selective Backup Restore"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose which devices or remotes to import"
                android:textColor="#64748B"
                android:textSize="12.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_close_selective"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_sheet_btn"
            android:text="✕"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </RelativeLayout>

    <!-- Select All / Deselect All Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/text_selective_found_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5 DEVICES IN BACKUP"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet_btn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Select All"
            android:textColor="#0284C7"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btn_deselect_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet_btn"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:text="Clear"
            android:textColor="#64748B"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Scrollable Items Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/container_selective_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="14dp">

        <!-- Restore Selected Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_restore_selected"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_sheet_btn_active"
            android:text="📥 Restore Selected Devices"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_marginBottom="8dp" />

        <!-- Restore All Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_restore_entire_hub"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_sheet_btn"
            android:text="🌐 Restore Entire Hub (All Devices)"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_marginBottom="8dp" />

        <!-- Cancel Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel_selective"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_sheet_btn"
            android:text="Cancel"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
