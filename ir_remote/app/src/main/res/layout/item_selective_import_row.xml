<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_action_chip"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/text_selective_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:background="#F1F5F9"
        android:text="🌀"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_selective_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fan 3: Living Room"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_selective_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="6 Learned Codes"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/check_selective_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
