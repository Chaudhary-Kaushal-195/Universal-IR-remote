<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Sheet Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Light Controller"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ambient LED • Universal IR"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sheet_btn_close_light"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="✕"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn"
                android:stateListAnimator="@null" />
        </RelativeLayout>

        <!-- Device Profile Selector (Up to 5 IR Code Profiles) -->
        <include layout="@layout/view_profile_selector" />

        <!-- Light Power Toggle -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/LIGHT_POWER"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="TOGGLE LIGHT POWER"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_sheet_btn_active"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null" />

        <!-- Brightness Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LIGHT_BRIGHT_UP"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Brightness +"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LIGHT_BRIGHT_DOWN"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Brightness —"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Color Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LIGHT_WHITE"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Warm"
                android:textColor="#1E293B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LIGHT_RED"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Red"
                android:textColor="#B91C1C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn_red"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LIGHT_BLUE"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Blue"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LIGHT_GREEN"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Green"
                android:textColor="#15803D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_sheet_btn_green"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
