<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_samsung_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_import_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import AC Profile"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose destination profile slot to save into"
                android:textColor="#64748B"
                android:textSize="12.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_close_import_slot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_sheet_btn"
            android:text="✕"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </RelativeLayout>

    <!-- Source Payload Info Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_action_chip"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_import_source_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#FEF3C7"
            android:text="❄️"
            android:textSize="20sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_import_source_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Living Room AC"
                android:textColor="#0F172A"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_import_source_codes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="14 Learned Codes Ready to Import"
                android:textColor="#D97706"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT TARGET PROFILE SLOT"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp" />

    <!-- Slot Choices Container -->
    <LinearLayout
        android:id="@+id/container_import_slots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp" />

    <!-- Cancel Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cancel_import_slot"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_sheet_btn"
        android:text="Cancel"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

</LinearLayout>
