<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_samsung_sheet">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Drag Handle -->
            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_drag_handle" />

            <!-- Rolling Time Picker Area (Samsung Clock Style in Clean Light Mode) -->
            <LinearLayout
                android:id="@+id/layout_samsung_wheel_picker"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#FFFFFF">

                <NumberPicker
                    android:id="@+id/picker_samsung_hour"
                    android:layout_width="65dp"
                    android:layout_height="160dp"
                    android:theme="@style/Theme.SamsungPicker"
                    android:descendantFocusability="blocksDescendants" />

                <TextView
                    android:id="@+id/tv_picker_colon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="#0F172A"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center" />

                <NumberPicker
                    android:id="@+id/picker_samsung_minute"
                    android:layout_width="65dp"
                    android:layout_height="160dp"
                    android:theme="@style/Theme.SamsungPicker"
                    android:descendantFocusability="blocksDescendants" />

                <NumberPicker
                    android:id="@+id/picker_samsung_ampm"
                    android:layout_width="65dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="12dp"
                    android:theme="@style/Theme.SamsungPicker"
                    android:descendantFocusability="blocksDescendants" />
            </LinearLayout>

            <!-- Samsung OneUI Rounded Light Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_samsung_alarm_card"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp"
                android:layout_marginTop="8dp">

                <!-- Date / Next Trigger Header & Calendar Picker -->
                <RelativeLayout
                    android:id="@+id/layout_date_header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/layout_calendar_controls"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tv_next_trigger_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tomorrow • Mon, 14 Sept"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_specific_date_subtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Specific calendar date scheduled"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_calendar_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/btn_clear_specific_date"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Clear Date"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/icon_calendar"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="📅"
                            android:textSize="18sp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Day Selector Row (S M T W T F S) -->
                <LinearLayout
                    android:id="@+id/layout_day_selector"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/btn_day_sun"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="#EF4444"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_day_unselected" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_day_mon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="M"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_day_unselected" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_day_tue"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_day_unselected" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_day_wed"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="W"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_day_unselected" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_day_thu"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_day_unselected" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_day_fri"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="F"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_day_unselected" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_day_sat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_day_unselected" />
                </LinearLayout>

                <!-- Thin Divider Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="14dp" />

                <!-- Alarm Name / Timer Label Input -->
                <EditText
                    android:id="@+id/input_timer_name"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@null"
                    android:hint="Alarm name"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:imeOptions="actionDone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CBD5E1"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp" />

                <!-- Action Section Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Action"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_action_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="🔴 Power OFF"
                        android:textColor="#2563EB"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Action Horizontal Selector Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/layout_action_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_power_off"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_samsung_chip_selected"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🔴 Power OFF"
                            android:textColor="#1D4ED8"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chip_power_on"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="⚡ Power ON"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chip_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🌡️ Temp (16-32°C)"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chip_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="❄️ Mode"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chip_fan"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="💨 Fan Speed"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chip_sleep"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🌙 Sleep"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chip_display"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="💡 Display"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Dynamic Sub-container: Temperature Stepper -->
                <LinearLayout
                    android:id="@+id/layout_samsung_temp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_samsung_chip_unselected"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Target Temperature"
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_samsung_temp_minus"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:text="−"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_pill_btn"
                        android:stateListAnimator="@null" />

                    <TextView
                        android:id="@+id/tv_samsung_temp_val"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="24°C"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_samsung_temp_plus"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:text="+"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_samsung_pill_btn"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- Dynamic Sub-container: Mode Chips -->
                <LinearLayout
                    android:id="@+id/layout_samsung_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_samsung_chip_unselected"
                    android:padding="10dp"
                    android:visibility="gone">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_mode_item_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_mode_cool"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_selected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="❄️ Cool"
                                android:textColor="#1D4ED8"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_mode_heat"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="🔥 Heat"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_mode_warm"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="☀️ Warm"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_mode_dry"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="💧 Dry"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_mode_auto"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="🔄 Auto"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_mode_fan"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="🌀 Fan"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Dynamic Sub-container: Fan Speed Chips -->
                <LinearLayout
                    android:id="@+id/layout_samsung_fan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_samsung_chip_unselected"
                    android:padding="10dp"
                    android:visibility="gone">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_fan_item_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_fan_1"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_selected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Speed 1"
                                android:textColor="#1D4ED8"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_fan_2"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Speed 2"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_fan_3"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Speed 3"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_fan_4"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Speed 4"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/chip_fan_auto"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_samsung_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Auto"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Dynamic Sub-container: Toggle State for Sleep & Display -->
                <LinearLayout
                    android:id="@+id/layout_samsung_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_samsung_chip_unselected"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_samsung_toggle_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Turn Feature ON / OFF"
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_toggle_on"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_samsung_chip_selected"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Turn ON"
                            android:textColor="#1D4ED8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chip_toggle_off"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_samsung_chip_unselected"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Turn OFF"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Floating Pill Bar: Cancel | Save (Light Theme) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_samsung_pill_btn">

                <TextView
                    android:id="@+id/btn_samsung_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="28dp"
                    android:paddingEnd="20dp"
                    android:text="Cancel"
                    android:textColor="#334155"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="#CBD5E1"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:id="@+id/btn_samsung_save"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="28dp"
                    android:text="Save"
                    android:textColor="#2563EB"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
