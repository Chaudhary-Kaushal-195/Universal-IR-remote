<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UniversalHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Neutral Theme Colors -->
        <item name="colorPrimary">#212121</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#424242</item>
        
        <!-- Status & Navigation bars -->
        <item name="android:statusBarColor">#E0E0E0</item>
        <item name="android:navigationBarColor">#E0E0E0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#E0E0E0</item>
        
        <!-- Default Typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        
        <!-- Disable automatic button tinting from MaterialComponents -->
        <item name="backgroundTint">@null</item>
        <item name="colorButtonNormal">@android:color/transparent</item>

        <!-- Fully Transparent BottomSheet Container for Clean Rounded Corners -->
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>

        <!-- Clean Light Calendar DatePicker Dialog Theme -->
        <item name="android:datePickerDialogTheme">@style/Theme.AppDatePicker</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@null</item>
    </style>

    <style name="Theme.SamsungPicker" parent="Theme.MaterialComponents.Light">
        <item name="android:textColorPrimary">#0F172A</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textSize">30sp</item>
        <item name="colorControlNormal">@android:color/transparent</item>
        <item name="colorControlActivated">#0F172A</item>
    </style>

    <!-- App Style Light DatePicker Dialog Theme -->
    <style name="Theme.AppDatePicker" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorPrimary">#2563EB</item>
        <item name="android:colorPrimaryDark">#1D4ED8</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/bg_dialog_calendar</item>
        <item name="android:textColorPrimary">#0F172A</item>
        <item name="android:textColorSecondary">#64748B</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:colorControlNormal">#64748B</item>
        <item name="android:colorControlActivated">#2563EB</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DatePickerButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DatePickerButton.Negative</item>
        
        <!-- Compat attributes for Material widgets -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        <item name="colorAccent">#2563EB</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="DatePickerButton.Positive" parent="android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textColor">#2563EB</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DatePickerButton.Negative" parent="android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textColor">#64748B</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
